<section class="page">
  <h1>Familles d'écrans</h1>

  <div class="toolbar">
    <div class="toolbar-left">
      <!-- Utilise le même style que "Gérer les familles" -->
      <a class="manage-btn" href="/screens">← Retour aux écrans</a>
    </div>
  </div>
  
  <% if (isAdmin) { %>
  <form class="card_screens" method="post" action="/families/create">
    <h2>Créer une famille</h2>
    <label>Nom de la famille
      <input name="name" placeholder="MTR, Parc, Musée…" required />
    </label>
    <button type="submit">Créer</button>
  </form>
  <% } else { %>
  <div class="card_screens" style="background: #fef3c7; border-color: #fbbf24;">
    <p>🔒 <strong>Mode lecture seule</strong> - Vous devez être OP niveau 3+ pour créer des familles.</p>
    <p style="font-size: 0.9rem; color: #78350f; margin: 0;">Demandez à un administrateur du serveur de vous donner les permissions avec <code>/op &lt;votre_nom&gt; 3</code></p>
  </div>
  <% } %>

  <div class="card_screens">
    <h2>Liste des familles</h2>
    <table class="table">
      <thead><tr><th>Nom</th><th>Écrans</th><% if (isAdmin) { %><th>Actions</th><% } %></tr></thead>
      <tbody>
        <% if (!families || families.length === 0) { %>
          <tr><td colspan="<%= isAdmin ? 3 : 2 %>" class="muted">Aucune famille</td></tr>
        <% } %>
        <% (families || []).forEach(f => { %>
          <tr>
            <td><%= f.name %></td>
            <td><%= f.screen_count %></td>
            <% if (isAdmin) { %>
            <td>
              <form method="post" action="/families/<%= f.id %>/delete" onsubmit="return confirm('Supprimer la famille « <%= f.name %> » ?');">
                <button type="submit" class="btn-danger" <%= f.screen_count>0 ? 'disabled' : '' %>>Supprimer</button>
              </form>
            </td>
            <% } %>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>