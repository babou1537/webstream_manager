<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' ? title + ' - ' : '' %>WebStream Manager</title>
  <link rel="stylesheet" href="/static/styles.css" />
</head>
<body>
  <!-- <header class="banner-header">
    <img src="/static/images/BaniereMinecraft.svg" alt="Bannière Minecraft" class="banner-img" />
  </header> -->
  <header class="site-header">
    <div class="header-left">
      <button class="nav-toggle" aria-label="Menu" aria-controls="topbar-links" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
      <img src="/static/images/BaniereMinecraft.svg" alt="Bannière Minecraft" class="banner-img" />
    </div>
    <div class="header-right">
      <div id="clock" class="clock" aria-label="Horloge"></div>
      <img src="/static/images/server-icon.png" alt="Icône serveur" class="server-icon" />
    </div>
  </header>

  <!-- Drawer vertical + backdrop -->
  <aside id="sidenav" class="sidenav" aria-label="Navigation latérale">
    <nav class="sidenav-links">
      <a href="/" class="<%= page==='home' ? 'active' : '' %>">Accueil</a>
      <a href="/library" class="<%= page==='library' ? 'active' : '' %>">Bibliothèque</a>
      <a href="/screens" class="<%= page==='screens' ? 'active' : '' %>">Écrans</a>
    </nav>
  </aside>
  <div id="sidenav-backdrop" class="sidenav-backdrop" aria-hidden="true"></div>

  <main>
    <% const _view = (typeof view === 'string' && view) ? view : 'partials/home'; %>
    <%- include(_view) %>
  </main>
  <script src="/static/uploader.js"></script>
  <script src="/static/preview.js"></script>
  <script src="/static/nav.js"></script>
</body>
</html>
